# RecoverFlow backend environment template
# Copy this file to backend/.env for local development and fill in your own values.
# Never commit real secrets.

APP_ENV=development

# Supabase PostgreSQL shared pooler. Session mode uses 5432.
# RecoverFlow local tooling automatically tries transaction mode 6543 if 5432
# cannot establish a PostgreSQL session on the current Windows/network setup.
DB_HOST=your-supabase-pooler-host
DB_PORT=5432
DB_NAME=postgres
DB_USER=your-supabase-pooler-user
DB_PASSWORD=your-database-password
DB_SSLMODE=require
# Supabase/Supavisor does not need GSS encryption; disabling negotiation avoids
# libpq/GSS compatibility issues seen on some local clients.
DB_GSSENCMODE=disable

# Local frontend origin. Production may contain comma-separated origins.
FRONTEND_ORIGINS=http://localhost:3000

# Razorpay Test Mode
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Gemini planner
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional OpenAI fallback. Keep false unless the API account has credits.
OPENAI_FALLBACK_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
